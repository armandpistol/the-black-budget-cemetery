# =====================================================================
# THE BLACK-BUDGET CEMETERY // v2.0 ENVIRONMENT TEMPLATE
# Copy this file to .env and populate with your credentials.
# =====================================================================

# Supabase PostgreSQL Connection Poolers
SUPABASE_POOLER_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_SESSION_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Ollama Multimodal & Embedding Server (Local or SSH Tunnel to GPU Server)
OLLAMA_BASE_URL=http://localhost:11435

# Groq Cloud LPU API (For Llama 3.1 8B Interrogation & LangGraph Agents)
GROQ_API_KEY=gsk_your_groq_api_key_here

# NARA Catalog API v2
NARA_API_KEY=your_nara_api_key_here